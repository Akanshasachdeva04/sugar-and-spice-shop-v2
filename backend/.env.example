# Copy this file to .env. Never commit .env to GitHub.

# Leave commented to use local SQLite (works out of the box).
# Production (Render Postgres): DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key

# Comma-separated list of frontend URLs allowed to call this API (no spaces, no trailing slash).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# First admin account — created automatically the first time the backend starts.
ADMIN_EMAIL=meenutandon@gmail.com
ADMIN_PASSWORD=meenu123@
ADMIN_NAME=Meenu

# From Razorpay Dashboard > Settings > API Keys (Test mode first: rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From 2Factor.in dashboard > API Keys. Used for signup + login phone OTP.
TWOFACTOR_API_KEY=

# From Cloudinary dashboard (cloudinary.com > free account > Dashboard page).
# Product/banner images upload here instead of local disk, so they survive
# redeploys and don't fill up server storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
